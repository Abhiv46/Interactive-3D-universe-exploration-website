{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/components/Scene.tsx",
    "src/components/Sun.tsx",
    "src/components/SurfaceTerrain.tsx",
    "src/components/Planet.tsx",
    "src/components/Earth.tsx",
    "src/components/TimeControlUI.tsx",
    "src/components/UIOverlay.tsx",
    "src/components/UI/InfoCard.tsx",
    "src/components/UI/SearchBar.tsx",
    "src/components/UI/DatePicker.tsx",
    "src/components/UI/TimeControlUI.tsx",
    "src/components/UI/SettingsPanel.tsx",
    "src/hooks/useKeplerianOrbit.ts",
    "src/hooks/useSimulationClock.ts",
    "src/hooks/useCameraControls.ts",
    "src/hooks/useSurfaceZoom.ts",
    "src/hooks/useLOD.ts",
    "src/hooks/useScale.ts",
    "src/context/SurfaceZoomContext.tsx",
    "src/context/ScaleContext.tsx",
    "src/engine/KeplerianOrbit.ts",
    "src/engine/SimulationClock.ts",
    "src/engine/Constants.ts",
    "src/data/planets.ts",
    "src/types/orbitalElements.ts",
    "src/index.css",
    "src/vite-env.d.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}